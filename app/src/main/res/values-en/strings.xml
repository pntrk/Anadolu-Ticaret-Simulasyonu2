    <string name="mgr_rd_title">Research &amp; Development Director</string>
    <string name="mgr_rd_desc">Hierarchy #5: Chief Technology Officer. Prioritizes deep-tech, automation, and industrial research projects required for consortium excellence and manufacturing output.</string>
